# Cross-origin isolation (COOP/COEP/CORP) is required for the WASM audio engine's shared-memory
# worklet, not just a hardening nicety — see vite-plugin-cross-origin-isolation's use in
# packages/app/studio/vite.config.ts, which provides the same headers for local dev/preview.
server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Cross-Origin-Embedder-Policy "require-corp" always;
    add_header Cross-Origin-Resource-Policy "cross-origin" always;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Same-origin proxy for the Demos section (see DemoProjectJson.tsx's OpenDawMusicProxyPath) —
    # api.opendaw.studio's CORS allowlist only trusts opendaw.studio/dev.opendaw.studio/localhost,
    # not this fork's Cloud Run domain, so the browser must see these as same-origin requests.
    location /proxy/opendaw-music/ {
        proxy_ssl_server_name on;
        proxy_set_header Host api.opendaw.studio;
        proxy_pass https://api.opendaw.studio/music/;
    }
}
